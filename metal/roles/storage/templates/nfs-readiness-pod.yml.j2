apiVersion: v1
kind: Pod
metadata:
  name: {{ nfs_readiness_pod.name }}
  namespace: {{ nfs_readiness_namespace }}
spec:
  securityContext:
    runAsUser: 1000
    runAsGroup: 1000
    runAsNonRoot: true
  containers:
    - name: probe
      image: busybox:latest
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          drop: [ALL]
      command: [/bin/sh, -ec]
      args:
        - |
          cat > /tmp/probe.sh <<'PROBE'
{{ lookup('file', role_path ~ '/files/nfs-readiness.sh') | indent(10, true) }}
          PROBE
{% if nfs_readiness_pod.name == 'reader' %}
          sleep 65
{% endif %}
{% for action in nfs_readiness_pod.actions %}
          sh /tmp/probe.sh {{ action }} /mnt/{{ 'ro' if action == 'readonly' else 'rw' }}
{% endfor %}
          echo 'NFS pod acceptance passed'
      volumeMounts:
        - name: fixture
          mountPath: /mnt/rw
        - name: fixture
          mountPath: /mnt/ro
          readOnly: true
  volumes:
    - name: fixture
      nfs:
        server: {{ hostvars[inventory_hostname].ansible_host | to_json }}
        path: /mnt/storage/99_tmp/nfs-readiness
  restartPolicy: Never
